{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/gallery(\\.html)?$",
      "dest": "/gallery.html"
    },
    {
      "src": "^/covered(\\.html)?$",
      "dest": "/covered_products_preview.html"
    },
    {
      "src": "^/placeholder(\\.html)?$",
      "dest": "/placeholder_verification_preview.html"
    },
    {
      "src": "^/image(\\.html)?$",
      "dest": "/covered_products_preview.html"
    },
    {
      "src": "^/tree(\\.html)?$",
      "dest": "/tree.html"
    },
    {
      "src": "^/tagging(\\.html)?$",
      "dest": "/tagging.html"
    },
    {
      "src": "^/weights(\\.html)?$",
      "dest": "/weights.html"
    },
    {
      "src": "^/navigation(\\.html)?$",
      "dest": "/navigation.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}